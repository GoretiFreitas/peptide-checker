# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Anything prefixed VITE_ is inlined into the browser bundle at build time and
# is therefore public. Everything else is server-only.

# --- Supabase (public) ------------------------------------------------------
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (secret) ------------------------------------------------------
# Bypasses RLS. Server-only; never expose to the client bundle.
# Without it every page that reads funding totals or the register fails.
SUPABASE_SERVICE_ROLE_KEY=

# --- Lovable AI gateway -----------------------------------------------------
# Powers certificate extraction and is metered — required by /.
LOVABLE_API_KEY=

# --- Payments ---------------------------------------------------------------
# The environment is a property of the deployment and is never accepted from
# the client. Set it explicitly; otherwise it is inferred from
# VITE_PAYMENTS_CLIENT_TOKEN, then from whichever secret key is configured.
# live | sandbox
PAYMENTS_ENVIRONMENT=sandbox

# Stripe publishable token — pk_test_… for sandbox, pk_live_… for live.
VITE_PAYMENTS_CLIENT_TOKEN=

STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=

# Signing secrets for /api/public/payments/webhook?env=sandbox|live
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
